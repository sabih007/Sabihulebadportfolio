# Copy to .env.local and fill in. None of these are required to run the site,
# but the contact form cannot deliver mail until the three CONTACT_* values are
# set — until then the API returns an honest "not configured" error instead of
# pretending to send. See app/api/contact/route.ts.

# Canonical production origin. Used for canonical URLs, Open Graph, sitemap
# and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://sabihulebad.com

# Transactional email provider (e.g. Resend). All three are required together.
CONTACT_PROVIDER_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
