# TEMPLATE ONLY — this file IS committed to git. Never put a real password here.
# Copy it to .env.local (which is gitignored) and fill the values in there.
#
# None of these are required to run the site, but the contact form cannot
# deliver mail until the SMTP block is set — until then the API validates,
# rejects spam, logs the enquiry and returns an honest "not configured" error
# rather than pretending to send.
# See app/api/contact/route.ts and lib/contact/mailer.ts.

# Canonical production origin. Used for canonical URLs, Open Graph, sitemap
# and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://sabihulebad.com

# --- SMTP (Nodemailer) -------------------------------------------------------
# Host and credentials from your mail provider. Port 465 uses implicit TLS;
# 587 upgrades with STARTTLS. SMTP_SECURE is inferred from the port when unset.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Where enquiries are delivered. Defaults to info@sabihulebad.com.
CONTACT_TO_EMAIL=info@sabihulebad.com

# Envelope sender. Must be an address this SMTP account is allowed to send as,
# or the message will fail SPF/DKIM and be filed as spam. Defaults to SMTP_USER.
# The visitor's own address is set as Reply-To, so replying still reaches them.
CONTACT_FROM_EMAIL=info@sabihulebad.com

# Example — Hostinger:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=info@sabihulebad.com
#   SMTP_PASS=<mailbox password — put this in .env.local, not here>
#
# Example — cPanel / shared hosting:
#   SMTP_HOST=mail.sabihulebad.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#
# Example — Gmail / Google Workspace (needs an App Password, not the account
# password, with 2-Step Verification enabled):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true

# --- Client feedback -------------------------------------------------------
# Reviews submitted at /feedback are stored on disk and stay unpublished until
# you approve them at /admin/feedback. See lib/feedback/store.ts.
#
# Password for the moderation queue. Minimum 12 characters; the queue is
# disabled while this is unset. REQUIRED to moderate reviews.
ADMIN_PASSWORD=

# Optional. Signs the admin session cookie; defaults to ADMIN_PASSWORD. Set it
# to a separate random string if you want sessions to survive a password change.
ADMIN_SESSION_SECRET=

# Optional. Where the feedback JSON file lives. Defaults to `.data/` in the
# project root. Point this at a directory OUTSIDE the deploy folder if your
# release process replaces the whole tree, or the reviews are lost on deploy:
#   FEEDBACK_DATA_DIR=/home/USER/portfolio-data
FEEDBACK_DATA_DIR=

# --- Search engines & analytics --------------------------------------------
# Verification tokens from the "HTML tag" method — the token only, not the tag.
# Google Search Console: Settings → Ownership verification → HTML tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional analytics. Nothing loads unless one of these is set.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
